#!/bin/bash
# Open a Twitch stream (streamlink -> mpv) and its chat (chatuino) side by
# side, or hot-swap an already-running pair to a new channel in place.
# With no argument, opens a picker prepopulated with live followed channels
# (sub > viewers > followed time), with search and free-text fallback.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  echo "twitch-watch: \$XDG_RUNTIME_DIR is not set (expected on any systemd" \
       "user session). Refusing to fall back to a shared /tmp path for the" \
       "mpv IPC socket." >&2
  exit 1
fi

SOCK="$XDG_RUNTIME_DIR/twitch-watch-mpv.sock"
STATE_DIR="$HOME/.local/state/twitch-watch"
STATE_FILE="$STATE_DIR/session.json"
CONFIG_FILE="$HOME/.config/twitch-watch/config.json"
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

# Refuses a symlink, a file owned by someone else, or anything implausibly
# large, before ever handing $1 to jq.
file_ok() {
  [[ -f "$1" && ! -L "$1" ]] || return 1
  [[ "$(stat -c %u -- "$1" 2>/dev/null)" == "$(id -u)" ]] || return 1
  local size
  size="$(stat -c %s -- "$1" 2>/dev/null)" || return 1
  (( size <= 65536 ))
}

# Atomic, symlink-safe write: mktemp creates a fresh regular file in the same
# directory (it never follows or reuses an existing symlink at that name),
# and `mv` replaces the destination via rename(2), which swaps the directory
# entry itself rather than writing through it -- so a pre-planted symlink at
# $STATE_FILE can't redirect the write elsewhere.
write_state() {
  local tmp
  tmp="$(mktemp "$STATE_DIR/.session.json.XXXXXX")"
  cat > "$tmp"
  mv -f "$tmp" "$STATE_FILE"
}

# Twitch login grammar: 4-25 letters/digits/underscore. Validated once here
# and enforced before $channel is ever used in a filename, a streamlink URL,
# or (via $STATE_FILE, itself only ever written after this check) the
# pkill/pgrep pattern in hot_swap -- so it can never carry a shell or regex
# metacharacter into any of those.
validate_channel() {
  [[ "$1" =~ ^[A-Za-z0-9_]{4,25}$ ]]
}

quality_setting="best"
if file_ok "$CONFIG_FILE"; then
  quality_setting="$(jq -r '.default_quality // "best"' "$CONFIG_FILE" 2>/dev/null || echo best)"
fi
# Allowlist matching SettingsView.qml's quality buttons exactly. A hand-edited
# config.json can't otherwise inject extra streamlink args here: an
# unvalidated value with spaces would word-split when expanded unquoted below.
quality="best"
if [[ "$quality_setting" != "best" ]]; then
  case "$quality_setting" in
    1080p60|720p60|480p) quality="$quality_setting,best" ;;
    *) echo "twitch-watch: ignoring invalid default_quality \"$quality_setting\" in config, using \"best\"." >&2 ;;
  esac
fi

pick_channel() {
  local live_lines result

  live_lines="$("$SCRIPT_DIR/twitch-followed-live" --menu-lines 2>/dev/null)" || live_lines=""

  if [[ -z "$live_lines" ]]; then
    result="$(omarchy-menu-input "Twitch channel")" || result=""
    printf '%s' "$result"
    return
  fi

  local sentinel picked
  sentinel=$'⌨️\tType a channel…\tEnter any Twitch login manually'
  picked="$(printf '%s\n%s\n' "$live_lines" "$sentinel" | omarchy-menu-select "Twitch channel")" || picked=""

  if [[ -z "$picked" ]]; then
    printf ''
    return
  fi

  if [[ "$picked" == *"Type a channel…"* ]]; then
    result="$(omarchy-menu-input "Twitch channel")" || result=""
    printf '%s' "$result"
  else
    printf '%s' "${picked%%$'\t'*}"
  fi
}

session_is_live() {
  file_ok "$STATE_FILE" || return 1
  [[ -S "$SOCK" ]] || return 1
  echo '{"command":["get_property","pid"]}' | timeout 1 socat - "UNIX-CONNECT:$SOCK" >/dev/null 2>&1
}

# Resets the chatuino window to the configured fixed width, if locked. Not a
# hard constraint (Hyprland has no runtime toggle for min/max_size enforcement,
# only static window rules) -- just a "known-good default on every session
# start/swap" reset; manual dragging afterward still works either way.
apply_locked_width() {
  local locked chat_width win_json cur_w delta
  locked="true"
  chat_width="420"
  if file_ok "$CONFIG_FILE"; then
    locked="$(jq -r '.locked // true' "$CONFIG_FILE" 2>/dev/null || echo true)"
    chat_width="$(jq -r '.chat_width // 420' "$CONFIG_FILE" 2>/dev/null || echo 420)"
  fi
  [[ "$locked" == "true" ]] || return 0

  for _ in $(seq 1 30); do
    win_json="$(hyprctl clients -j | jq -c '[.[] | select(.title=="Chatuino")][0] // empty' 2>/dev/null)"
    [[ -n "$win_json" ]] && break
    sleep 0.1
  done
  [[ -n "$win_json" ]] || return 0

  # Hyprland's tiled resize dispatcher is delta-based even in "absolute" mode,
  # and the sign is inverted for a window on the right side of a split
  # (confirmed empirically): a positive delta SHRINKS it, negative GROWS it.
  # So the delta that lands on an exact target width is (current - target).
  cur_w="$(jq -r '.size[0]' <<<"$win_json")"
  delta=$((cur_w - chat_width))
  [[ "$delta" -eq 0 ]] && return 0
  hyprctl dispatch "hl.dsp.window.resize({ x=$delta, y=0, relative=true, window=\"title:^(Chatuino)\$\" })" >/dev/null 2>&1
}

# mpv floats intermittently: shortly after a stream loads, it auto-resizes to
# the video's native aspect ratio, and Hyprland sometimes treats that
# follow-up size request as a "wants a fixed size" hint and floats it -- a
# static `float = false` window rule doesn't prevent this since it's a
# post-map behavior. Poll for a few seconds and force it back to tiled
# whenever the race happens.
apply_tiled_mpv() {
  local i floating
  for i in $(seq 1 20); do
    floating="$(hyprctl clients -j | jq -r '[.[] | select(.class=="mpv")][0].floating // empty' 2>/dev/null)"
    if [[ "$floating" == "true" ]]; then
      hyprctl dispatch 'hl.dsp.window.float({ action = "off", window = "class:^(mpv)$" })' >/dev/null 2>&1
    fi
    sleep 0.3
  done
}

# dwindle's insertion side for a freshly-opened window isn't reliably
# steerable from a script -- `preselect <dir>` was tried and empirically
# moved the wrong window regardless of direction (likely a focus-timing
# issue through the multi-step terminal-launch chain). Deterministic
# alternative: wait for both windows, check their actual X position, and
# swap if chatuino landed left of mpv. `hl.dsp.window.swap` has no `window`
# target param -- it operates on the currently ACTIVE window, which is
# chatuino here since it's the one just launched and terminal emulators grab
# focus on open.
apply_orientation() {
  local mpv_json chat_json mpv_x chat_x
  for _ in $(seq 1 30); do
    mpv_json="$(hyprctl clients -j | jq -c '[.[] | select(.class=="mpv")][0] // empty' 2>/dev/null)"
    chat_json="$(hyprctl clients -j | jq -c '[.[] | select(.title=="Chatuino")][0] // empty' 2>/dev/null)"
    [[ -n "$mpv_json" && -n "$chat_json" ]] && break
    sleep 0.2
  done
  [[ -n "$mpv_json" && -n "$chat_json" ]] || return 0

  mpv_x="$(jq -r '.at[0]' <<<"$mpv_json")"
  chat_x="$(jq -r '.at[0]' <<<"$chat_json")"
  if [[ "$chat_x" -lt "$mpv_x" ]]; then
    hyprctl dispatch 'hl.dsp.window.swap({ direction = "r" })' >/dev/null 2>&1
  fi
}

fresh_launch() {
  local ch="$1" slpid
  rm -f "$SOCK"
  streamlink --player mpv --title "Twitch - $ch" \
    --player-args "--input-ipc-server=$SOCK" \
    "twitch.tv/$ch" "$quality" &
  slpid=$!
  # Orientation must be corrected before the width lock runs -- that resize
  # math is calibrated for a right-side chatuino.
  ( apply_orientation; apply_locked_width ) &
  ( apply_tiled_mpv & )
  jq -n --arg ch "$ch" --arg sock "$SOCK" --arg id "chatuino-$ch" --argjson pid "$slpid" \
    '{channel:$ch, mpv_ipc_socket:$sock, chatuino_app_id:$id, streamlink_pid:$pid}' | write_state
  exec omarchy-launch-tui --app-id="chatuino-$ch" chatuino --tab "$ch"
}

hot_swap() {
  local new="$1" old url old_pattern slpid

  file_ok "$STATE_FILE" || { echo "twitch-watch: $STATE_FILE missing or untrustworthy" >&2; exit 1; }
  old="$(jq -r '.channel' "$STATE_FILE")"
  if [[ "$new" == "$old" ]]; then
    exit 0
  fi

  url="$(streamlink --stream-url "twitch.tv/$new" "$quality")" || {
    command -v notify-send >/dev/null 2>&1 && notify-send "Twitch" "Couldn't resolve $new"
    exit 1
  }

  jq -cn --arg u "$url" '{command:["loadfile",$u,"replace"]}' | socat - "UNIX-CONNECT:$SOCK"
  jq -cn --arg t "Twitch - $new" '{command:["set_property","title",$t]}' | socat - "UNIX-CONNECT:$SOCK"

  # Ghostty (--gtk-single-instance=true) rejects the --class override Omarchy
  # sends it, so every chatuino window carries the same generic class -- wait
  # on the process actually exiting instead of a window-class check.
  # $old came from $STATE_FILE, which is only ever written below (and in
  # fresh_launch) with a channel that already passed validate_channel, so it
  # can't carry a pkill/pgrep regex metacharacter here.
  old_pattern="chatuino --tab ${old}\$"
  pkill -f -- "$old_pattern" || true
  for _ in $(seq 1 20); do
    pgrep -f -- "$old_pattern" >/dev/null 2>&1 || break
    sleep 0.1
  done
  setsid omarchy-launch-tui --app-id="chatuino-$new" chatuino --tab "$new" >/dev/null 2>&1 &
  apply_locked_width &
  apply_tiled_mpv &

  # The original `streamlink --player mpv ...` process from fresh_launch is
  # mpv's actual process supervisor, not a disposable resolver -- it must
  # keep running untouched, or mpv (which we just hot-swapped in place) dies
  # with it. Only its PID carries forward into the new state.
  slpid="$(jq -r '.streamlink_pid // empty' "$STATE_FILE")"

  jq -n --arg ch "$new" --arg sock "$SOCK" --arg id "chatuino-$new" --argjson pid "${slpid:-null}" \
    '{channel:$ch, mpv_ipc_socket:$sock, chatuino_app_id:$id, streamlink_pid:$pid}' | write_state
}

channel="${1:-}"
if [[ -z "$channel" ]]; then
  channel="$(pick_channel)"
  [[ -z "$channel" ]] && exit 0
fi

if ! validate_channel "$channel"; then
  echo "twitch-watch: \"$channel\" isn't a valid Twitch login (4-25 letters/digits/underscore)." >&2
  command -v notify-send >/dev/null 2>&1 && notify-send "Twitch" "\"$channel\" isn't a valid Twitch channel name"
  exit 1
fi

if session_is_live; then
  hot_swap "$channel"
else
  fresh_launch "$channel"
fi

#!/bin/bash
# Twitch device-code OAuth for twitch-watch's own registered app.
# Token is kept in the system keyring (service=twitch-watch), separate from
# chatuino's own credential (service=chatuino).
set -euo pipefail

CONFIG_FILE="$HOME/.config/twitch-watch/config.json"
SECRET_SERVICE="twitch-watch"
SECRET_USERNAME="oauth-token"
SCOPES="user:read:follows user:read:subscriptions"

client_id() {
  jq -r '.client_id' "$CONFIG_FILE" 2>/dev/null
}

store_token() {
  secret-tool store --label="twitch-watch OAuth token" service "$SECRET_SERVICE" username "$SECRET_USERNAME"
}

load_token() {
  secret-tool lookup service "$SECRET_SERVICE" username "$SECRET_USERNAME"
}

cmd_login() {
  local cid
  cid="$(client_id)"
  if [[ -z "$cid" || "$cid" == "null" ]]; then
    echo "Set client_id in $CONFIG_FILE first (see dev.twitch.tv/console/apps)." >&2
    exit 1
  fi

  local resp device_code user_code verification_uri interval expires_in
  resp="$(curl -sf -X POST "https://id.twitch.tv/oauth2/device" \
    -d "client_id=$cid" \
    --data-urlencode "scopes=$SCOPES")"
  device_code="$(jq -r '.device_code' <<<"$resp")"
  user_code="$(jq -r '.user_code' <<<"$resp")"
  verification_uri="$(jq -r '.verification_uri' <<<"$resp")"
  interval="$(jq -r '.interval' <<<"$resp")"
  expires_in="$(jq -r '.expires_in' <<<"$resp")"

  echo "Visit: $verification_uri"
  echo "Enter code: $user_code"
  command -v xdg-open >/dev/null 2>&1 && xdg-open "$verification_uri" >/dev/null 2>&1 &

  local waited=0 token_resp="" access_token=""
  while (( waited < expires_in )); do
    sleep "$interval"
    waited=$((waited + interval))
    token_resp="$(curl -s -X POST "https://id.twitch.tv/oauth2/token" \
      -d "client_id=$cid" \
      -d "device_code=$device_code" \
      -d "grant_type=urn:ietf:params:oauth:grant-type:device_code")"
    access_token="$(jq -r '.access_token // empty' <<<"$token_resp")"
    if [[ -n "$access_token" ]]; then
      break
    fi
    local err
    err="$(jq -r '.message // empty' <<<"$token_resp")"
    case "$err" in
      authorization_pending|"") ;;
      slow_down) interval=$((interval + 5)) ;;
      *) echo "Auth failed: $err" >&2; exit 1 ;;
    esac
  done

  if [[ -z "$access_token" ]]; then
    echo "Timed out waiting for authorization." >&2
    exit 1
  fi

  local refresh_token expires_in2 user_resp user_id login
  refresh_token="$(jq -r '.refresh_token' <<<"$token_resp")"
  expires_in2="$(jq -r '.expires_in' <<<"$token_resp")"

  user_resp="$(curl -sf "https://api.twitch.tv/helix/users" \
    -H "Authorization: Bearer $access_token" \
    -H "Client-Id: $cid")"
  user_id="$(jq -r '.data[0].id' <<<"$user_resp")"
  login="$(jq -r '.data[0].login' <<<"$user_resp")"

  jq -n --arg at "$access_token" --arg rt "$refresh_token" \
    --argjson exp "$expires_in2" --argjson obtained "$(date +%s)" \
    --arg uid "$user_id" --arg login "$login" \
    '{access_token:$at, refresh_token:$rt, expires_in:$exp, obtained_at:$obtained, user_id:$uid, login:$login}' \
    | store_token

  echo "Logged in as $login"
}

cmd_token() {
  local force="${1:-}"
  local blob access_token expires_in obtained_at refresh_token now cid uid login

  blob="$(load_token)"
  access_token="$(jq -r '.access_token' <<<"$blob")"
  expires_in="$(jq -r '.expires_in' <<<"$blob")"
  obtained_at="$(jq -r '.obtained_at' <<<"$blob")"
  refresh_token="$(jq -r '.refresh_token' <<<"$blob")"
  uid="$(jq -r '.user_id' <<<"$blob")"
  login="$(jq -r '.login' <<<"$blob")"
  now="$(date +%s)"

  if [[ "$force" == "--force-refresh" ]] || (( now > obtained_at + expires_in - 300 )); then
    cid="$(client_id)"
    local resp new_access new_refresh new_exp
    resp="$(curl -sf -X POST "https://id.twitch.tv/oauth2/token" \
      -d "client_id=$cid" \
      -d "refresh_token=$refresh_token" \
      -d "grant_type=refresh_token")"
    new_access="$(jq -r '.access_token' <<<"$resp")"
    new_refresh="$(jq -r '.refresh_token' <<<"$resp")"
    new_exp="$(jq -r '.expires_in' <<<"$resp")"

    jq -n --arg at "$new_access" --arg rt "$new_refresh" \
      --argjson exp "$new_exp" --argjson obtained "$now" \
      --arg uid "$uid" --arg login "$login" \
      '{access_token:$at, refresh_token:$rt, expires_in:$exp, obtained_at:$obtained, user_id:$uid, login:$login}' \
      | store_token

    access_token="$new_access"
  fi

  echo "$access_token"
}

cmd_whoami() {
  load_token | jq -c '{user_id, login}'
}

case "${1:-}" in
  login) cmd_login ;;
  token) shift; cmd_token "${1:-}" ;;
  whoami) cmd_whoami ;;
  *)
    echo "Usage: twitch-auth {login|token [--force-refresh]|whoami}" >&2
    exit 1
    ;;
esac
